# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# database (runtime data, re-create with db:push + db:seed)
# 默认拒绝整个目录：此前的列举式规则（*.sqlite 等）盖不住 db.sqlite.bak-<时间戳>-wal
# 这类备份命名，导致含密码哈希的备份文件进了公开仓库
/data/*
!/data/.gitkeep

# runtime uploads (server content, sync separately or re-upload)
/public/uploads/*
!/public/uploads/.gitkeep

# drizzle output snapshots can be committed; keep migrations in repo

# local dev server logs
server.log
server-dev-check.log
