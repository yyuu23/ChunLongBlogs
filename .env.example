# ===== ChunLong Blog 环境变量 =====
# 复制为 .env 并按需修改；.env 已被 gitignore，不会入库

# 管理员账号（首次 npm run db:seed 时写入数据库，密码以 bcrypt 哈希存储）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-please

# JWT 签名密钥：生产环境必须换成随机长字符串，例如
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=dev-secret-do-not-use-in-production

# 站点对外地址（RSS / SEO 用）
SITE_URL=http://localhost:3000

# 生产经 deploy/nginx 反代时设为 1；应用端口若直接暴露公网必须设为 0。
# 只有可信反代模式才读取 X-Real-IP / X-Forwarded-For。
TRUST_PROXY=0

# SQLite 数据库文件路径（相对项目根目录）
DATABASE_PATH=data/db.sqlite

# ===== AI 聊天助手（可选，OpenAI 兼容协议）=====
# 国内直连推荐 DeepSeek（https://platform.deepseek.com）或智谱（https://open.bigmodel.cn）
# Gemini 等海外服务需要代理。配置 Key 后，左下角小助手即可聊天
# 三家 key 可同时常驻；模型预设/默认模型/思考开关/每访客限额在 /admin/ai-chat 管理：
# DEEPSEEK_API_KEY=sk-xxxx
# DEEPSEEK_API_BASE=https://api.deepseek.com/v1
# GLM_API_KEY=xxxx
# GLM_API_BASE=https://open.bigmodel.cn/api/paas/v4
# QWEN_API_KEY=sk-xxxx
# QWEN_API_BASE=https://llm-mhzccuzghu9iwggm.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
# LLM_PROVIDER=glm         # 兜底默认供应商 deepseek | glm | qwen（预设不可用时回退）
# 模型名按需覆盖（不填用默认：deepseek-chat / glm-5.3-flash / qwen3.8-flash）：
# GLM_MODEL=glm-5.3-flash
# DEEPSEEK_MODEL=deepseek-chat
# QWEN_MODEL=qwen3.8-flash
# 通用覆盖（配置后优先于以上全部，接任意 OpenAI 兼容服务）：
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_API_KEY=sk-xxxx
# LLM_MODEL=deepseek-chat

# 聊天成本护栏：
# CHAT_RATE_LIMIT=20     # 同 IP 每分钟最多几次（挡"快"）
# CHAT_DAILY_LIMIT=500   # 全站每日总额度，超出返回"明天再来"（SQLite 持久计数，pm2 重启不清零）

# AI 助手联网搜索工具（可选；不配则该工具自动禁用）：
# SEARCH_API_KEY=tvly-xxxx        # 或 TAVILY_API_KEY，任一即可（https://tavily.com）
# ===== AI 博客问答·语义检索（可选，OpenAI 兼容 embedding）=====
# 不配则自动退回关键词检索，问答功能同样可用（配置说明见后台「站点设置 → AI 博客问答」）：
# EMBEDDING_API_KEY=xxxx
# EMBEDDING_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# EMBEDDING_MODEL=embedding-3     # 推荐智谱 embedding-3

# ===== GitHub 访客登录（可选；留空则登录/评论入口自动隐藏，游客点赞仍可用）=====
# 在 https://github.com/settings/developers 创建 OAuth App：
#   生产：Authorization callback URL 填 https://chunlongblog.cn/api/auth/github/callback
#   本地开发：另建一个 App 回调 http://localhost:3000/api/auth/github/callback（GitHub 每个 App 只认一个回调域名）
# GITHUB_CLIENT_ID=Iv1.xxxxxxxxxxxxxxxx
# GITHUB_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
